<?xml version="1.0" encoding="utf-8"?>
<!--
  Somee: publish the backend to a local folder, then upload that folder (see deploy/somee/README.md).
  Contains no hosts, credentials or secrets. Configuration values are injected only into the local
  output by deploy/somee/Prepare-SomeeUpload.ps1.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <!-- PublishUrl is used by Visual Studio, PublishDir by dotnet publish. -->
    <PublishUrl>$(MSBuildProjectDirectory)\..\..\..\artifacts\publish\somee\</PublishUrl>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\..\artifacts\publish\somee\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ProjectGuid>8bdeb480-700c-4c02-8e74-95e5c568716e</ProjectGuid>
  </PropertyGroup>
</Project>
